#!/usr/bin/env bash
set -euo pipefail

[[ "${1:-}" == prepared ]] || exit 0

# Claude Code から codex CLI を呼ぶと両方の環境変数が入るため、Codex を優先する。
if [[ -n "${CODEX_THREAD_ID:-}" ]]; then
  agent=codex
  label=Codex
elif [[ -n "${CLAUDECODE:-}" ]]; then
  agent=claude
  label="Claude Code"
else
  exit 0
fi

# clone や初回コミットで作られる初期ブランチは対象外にする。
git rev-parse --verify --quiet HEAD >/dev/null || exit 0

while read -r _old_value new_value ref_name; do
  [[ "$ref_name" == refs/heads/* ]] || continue
  [[ "$new_value" == *[!0]* ]] || continue

  # 強制更新でも old_value がゼロになるため、参照の有無で新規作成を判定する。
  git show-ref --verify --quiet "$ref_name" && continue

  # PR の取得など、リモートに存在するブランチのチェックアウトは対象外にする。
  [[ -n "$(git for-each-ref --count=1 "refs/remotes/*/${ref_name#refs/heads/}")" ]] && continue

  [[ "$ref_name" == "refs/heads/agent/${agent}/"?* ]] && continue

  printf '%s の新規ブランチは agent/%s/ で始めてください: %s\n' "$label" "$agent" "${ref_name#refs/heads/}" >&2
  exit 1
done
