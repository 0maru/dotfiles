{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/workspaces/github.com/0maru/wezterm-agent-dashboard/hook.sh\" codex session-start"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/skills/validate-docs/scripts/check_docs.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/workspaces/github.com/0maru/wezterm-agent-dashboard/hook.sh\" codex user-prompt-submit"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.agents/skills/validate-docs/scripts/check_docs.py\" --hook",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/workspaces/github.com/0maru/wezterm-agent-dashboard/hook.sh\" codex activity-log"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$HOME/workspaces/github.com/0maru/wezterm-agent-dashboard/hook.sh\" codex stop"
          }
        ]
      }
    ]
  }
}
